<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#081F49" />
  <meta name="description" content="Truly Kampung Inggris Pontianak — English Camp intensif 3 bulan untuk mempercepat speaking, memperkuat grammar, reading, pronunciation, public speaking, hingga menuju Teaching Entry." />
  <title>Truly Kampung Inggris — Speak. Grow. Teach.</title>
  <link rel="icon" type="image/webp" href="data:image/webp;base64," />
  <style>
    :root{
      --navy:#0D2A63;
      --navy-deep:#071A3C;
      --blue:#1A3A8A;
      --red:#D61F2C;
      --red-dark:#B91825;
      --cream:#F7F4EE;
      --paper:#FCFBF8;
      --soft:#EEF3F9;
      --ink:#101828;
      --muted:#61708A;
      --line:rgba(13,42,99,.12);
      --white:#fff;
      --shadow:0 24px 80px rgba(7,26,60,.14);
      --shadow-sm:0 12px 32px rgba(7,26,60,.10);
      --radius:30px;
      --radius-md:22px;
      --max:1180px;
    }

    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      color:var(--ink);
      background:var(--paper);
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      -webkit-font-smoothing:antialiased;
      text-rendering:optimizeLegibility;
      overflow-x:hidden;
    }
    body.menu-open{overflow:hidden}
    a{color:inherit;text-decoration:none}
    img{max-width:100%;display:block}
    button,input{font:inherit}

    .announcement{
      position:relative;
      z-index:60;
      background:var(--red);
      color:#fff;
      font-weight:800;
      letter-spacing:.01em;
      font-size:14px;
    }
    .announcement .inner{
      max-width:var(--max);
      margin:auto;
      min-height:40px;
      display:flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      padding:8px 20px;
      text-align:center;
    }
    .pulse-dot{
      width:8px;height:8px;border-radius:99px;background:#fff;
      box-shadow:0 0 0 0 rgba(255,255,255,.75);
      animation:pulse 1.7s infinite;
      flex:0 0 auto;
    }
    @keyframes pulse{70%{box-shadow:0 0 0 9px rgba(255,255,255,0)}100%{box-shadow:0 0 0 0 rgba(255,255,255,0)}}

    .nav{
      position:sticky;
      top:0;
      z-index:50;
      backdrop-filter:blur(18px);
      background:rgba(252,251,248,.84);
      border-bottom:1px solid rgba(13,42,99,.07);
    }
    .nav-inner{
      max-width:var(--max);
      margin:auto;
      height:76px;
      padding:0 20px;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:24px;
    }
    .brand{display:flex;align-items:center;gap:11px;min-width:0}
    .brand-logo{width:48px;height:48px;border-radius:16px;object-fit:contain;background:#fff;box-shadow:0 8px 22px rgba(13,42,99,.08)}
    .brand-copy{line-height:1.02}
    .brand-copy strong{display:block;color:var(--navy);font-size:16px;letter-spacing:-.02em}
    .brand-copy span{font-size:10px;color:var(--red);font-weight:900;letter-spacing:.14em;text-transform:uppercase}
    .nav-links{display:flex;align-items:center;gap:28px;color:#3F4E67;font-size:14px;font-weight:700}
    .nav-links a:hover{color:var(--navy)}
    .btn{
      min-height:48px;
      border-radius:999px;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      padding:0 20px;
      font-weight:900;
      border:1px solid transparent;
      transition:.22s ease;
      cursor:pointer;
      white-space:nowrap;
    }
    .btn-primary{background:var(--navy);color:#fff;box-shadow:0 12px 24px rgba(13,42,99,.18)}
    .btn-primary:hover{background:#0a2252;transform:translateY(-2px)}
    .btn-red{background:var(--red);color:#fff;box-shadow:0 14px 26px rgba(214,31,44,.23)}
    .btn-red:hover{background:var(--red-dark);transform:translateY(-2px)}
    .btn-light{background:#fff;color:var(--navy);border-color:rgba(13,42,99,.12)}
    .btn-light:hover{transform:translateY(-2px);box-shadow:var(--shadow-sm)}
    .menu-btn{display:none;border:0;background:transparent;color:var(--navy);width:46px;height:46px;border-radius:14px;align-items:center;justify-content:center}

    .hero{
      position:relative;
      min-height:calc(100vh - 116px);
      padding:84px 20px 74px;
      overflow:hidden;
      isolation:isolate;
      background:
        radial-gradient(circle at 82% 13%, rgba(214,31,44,.13), transparent 26%),
        radial-gradient(circle at 8% 90%, rgba(26,58,138,.14), transparent 28%),
        linear-gradient(180deg,#FCFBF8 0%,#F7F9FC 100%);
    }
    .hero:before{
      content:"";
      position:absolute;
      inset:0;
      background-image:linear-gradient(rgba(13,42,99,.035) 1px, transparent 1px),linear-gradient(90deg,rgba(13,42,99,.035) 1px,transparent 1px);
      background-size:48px 48px;
      mask-image:linear-gradient(to bottom,rgba(0,0,0,.6),transparent 88%);
      z-index:-2;
    }
    .hero-orb{position:absolute;border-radius:999px;filter:blur(2px);z-index:-1;opacity:.8}
    .orb-1{width:170px;height:170px;background:#E9EEF8;top:9%;right:-45px}
    .orb-2{width:105px;height:105px;background:#F9D9DC;bottom:7%;left:-24px}
    .hero-grid{
      max-width:var(--max);
      margin:auto;
      display:grid;
      grid-template-columns:minmax(0,1.12fr) minmax(360px,.88fr);
      gap:64px;
      align-items:center;
    }
    .eyebrow{
      display:inline-flex;
      align-items:center;
      gap:9px;
      color:var(--navy);
      border:1px solid rgba(13,42,99,.13);
      background:rgba(255,255,255,.75);
      border-radius:999px;
      padding:9px 14px;
      text-transform:uppercase;
      font-size:11px;
      font-weight:950;
      letter-spacing:.13em;
      margin-bottom:24px;
    }
    .eyebrow i{width:7px;height:7px;border-radius:50%;background:var(--red);display:inline-block}
    h1{
      margin:0;
      max-width:760px;
      color:var(--navy-deep);
      font-size:clamp(52px,6.6vw,92px);
      line-height:.91;
      letter-spacing:-.068em;
      font-weight:950;
    }
    h1 .accent{color:var(--red);display:block}
    .hero-lead{
      max-width:700px;
      margin:28px 0 0;
      color:#45546D;
      font-size:clamp(17px,1.65vw,21px);
      line-height:1.68;
    }
    .hero-lead strong{color:var(--navy);font-weight:900}
    .hero-actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:34px}
    .microproof{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-top:30px;color:#5C6980;font-size:13px;font-weight:700}
    .microproof span{display:inline-flex;align-items:center;gap:7px}
    .tick{width:20px;height:20px;border-radius:99px;background:#EAF5EE;color:#1B7A3D;display:inline-flex;align-items:center;justify-content:center;font-size:11px;font-weight:1000}

    .hero-panel{position:relative}
    .hero-panel:before{
      content:"";
      position:absolute;
      width:90%;height:90%;
      right:-5%;top:8%;
      border-radius:38px;
      background:var(--navy);
      transform:rotate(4.5deg);
      opacity:.98;
      box-shadow:var(--shadow);
    }
    .journey-card{
      position:relative;
      z-index:2;
      overflow:hidden;
      border-radius:36px;
      background:#fff;
      border:1px solid rgba(13,42,99,.08);
      box-shadow:var(--shadow);
      padding:28px;
    }
    .card-top{display:flex;align-items:center;justify-content:space-between;gap:16px}
    .card-label{font-size:12px;font-weight:950;color:var(--navy);text-transform:uppercase;letter-spacing:.12em}
    .status-badge{background:#FFF0F1;color:var(--red);border-radius:999px;padding:8px 11px;font-size:11px;font-weight:950;display:inline-flex;align-items:center;gap:7px}
    .journey-card h3{font-size:34px;line-height:1.02;letter-spacing:-.04em;color:var(--navy-deep);margin:24px 0 9px}
    .journey-card .sub{margin:0;color:var(--muted);line-height:1.55;font-size:14px}
    .seat-meter{margin-top:25px;background:#F6F8FB;border-radius:20px;padding:18px}
    .seat-row{display:flex;justify-content:space-between;gap:12px;align-items:end;margin-bottom:12px}
    .seat-row strong{color:var(--navy);font-size:17px}
    .seat-row small{font-weight:900;color:var(--red)}
    .meter{height:8px;background:#E2E7EF;border-radius:999px;overflow:hidden}
    .meter span{display:block;width:72%;height:100%;background:linear-gradient(90deg,var(--navy),var(--red));border-radius:inherit}
    .journey-list{display:grid;gap:12px;margin-top:20px}
    .journey-item{display:grid;grid-template-columns:42px 1fr auto;align-items:center;gap:12px;padding:13px;border-radius:18px;border:1px solid var(--line)}
    .journey-item .num{width:42px;height:42px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-weight:950;background:var(--soft);color:var(--navy)}
    .journey-item:nth-child(3) .num{background:#FFF0F1;color:var(--red)}
    .journey-item strong{display:block;color:var(--navy);font-size:14px}
    .journey-item small{color:var(--muted);font-weight:700}
    .journey-item .arrow{color:#A0AABA;font-size:18px}
    .signature{margin-top:23px;padding-top:19px;border-top:1px dashed rgba(13,42,99,.17);display:flex;align-items:center;justify-content:space-between;gap:15px}
    .signature strong{font-size:14px;color:var(--navy)}
    .signature span{font-size:12px;color:var(--muted);font-weight:700}
    .scribble{font-weight:950;color:var(--red);letter-spacing:.04em}

    .strip{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:#fff}
    .strip-inner{max-width:var(--max);margin:auto;display:grid;grid-template-columns:repeat(4,1fr);padding:0 20px}
    .stat{padding:29px 28px;border-right:1px solid var(--line)}
    .stat:first-child{padding-left:0}
    .stat:last-child{border-right:0}
    .stat strong{display:block;color:var(--navy);font-size:28px;letter-spacing:-.045em}
    .stat span{display:block;color:var(--muted);font-size:12px;font-weight:800;margin-top:4px}

    section{padding:104px 20px}
    .section-wrap{max-width:var(--max);margin:auto}
    .section-head{display:grid;grid-template-columns:.9fr 1.1fr;gap:60px;align-items:end;margin-bottom:48px}
    .kicker{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--red);font-weight:950;margin-bottom:15px}
    h2{margin:0;color:var(--navy-deep);font-size:clamp(38px,4.5vw,64px);line-height:.98;letter-spacing:-.055em}
    .section-head p{margin:0;color:var(--muted);font-size:17px;line-height:1.75;max-width:630px}

    .why{background:var(--navy-deep);color:#fff;position:relative;overflow:hidden}
    .why:before{content:"TRULY";position:absolute;right:-30px;top:-42px;font-size:220px;font-weight:950;letter-spacing:-.08em;color:rgba(255,255,255,.025)}
    .why h2{color:#fff}
    .why .section-head p{color:#B9C5D9}
    .why-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:22px}
    .feature-big,.feature-card{border:1px solid rgba(255,255,255,.10);background:rgba(255,255,255,.055);border-radius:28px;overflow:hidden}
    .feature-big{padding:34px;min-height:390px;display:flex;flex-direction:column;justify-content:space-between;background:linear-gradient(145deg,rgba(214,31,44,.18),rgba(255,255,255,.04))}
    .feature-big .icon-ring{width:64px;height:64px;border-radius:22px;display:flex;align-items:center;justify-content:center;background:#fff;color:var(--red);font-size:26px}
    .feature-big h3{font-size:37px;line-height:1.05;letter-spacing:-.045em;margin:30px 0 12px}
    .feature-big p{color:#C5CFE0;line-height:1.7;margin:0;max-width:550px}
    .feature-stack{display:grid;grid-template-columns:1fr 1fr;gap:22px}
    .feature-card{padding:25px;min-height:184px}
    .feature-card .mini-icon{font-size:21px;margin-bottom:28px}
    .feature-card h4{margin:0 0 8px;font-size:18px}
    .feature-card p{margin:0;color:#B9C5D9;font-size:13px;line-height:1.6}

    .pillars{background:#fff}
    .pillar-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:14px}
    .pillar-card{position:relative;min-height:305px;border-radius:26px;padding:24px;background:#F6F8FB;border:1px solid rgba(13,42,99,.06);display:flex;flex-direction:column;justify-content:space-between;overflow:hidden;transition:.25s ease}
    .pillar-card:hover{transform:translateY(-6px);box-shadow:var(--shadow-sm);background:#fff}
    .pillar-card:before{content:"";position:absolute;inset:auto -30px -50px auto;width:140px;height:140px;border-radius:50%;background:rgba(13,42,99,.04)}
    .pillar-card:nth-child(2):before,.pillar-card:nth-child(5):before{background:rgba(214,31,44,.05)}
    .pillar-num{font-size:11px;font-weight:950;letter-spacing:.12em;color:var(--red)}
    .pillar-icon{width:50px;height:50px;border-radius:16px;display:flex;align-items:center;justify-content:center;background:#fff;color:var(--navy);box-shadow:0 9px 20px rgba(13,42,99,.07);font-size:23px}
    .pillar-card h3{font-size:22px;line-height:1.1;letter-spacing:-.03em;color:var(--navy);margin:0 0 10px}
    .pillar-card p{font-size:13px;color:var(--muted);line-height:1.6;margin:0}

    .roadmap{background:var(--cream)}
    .roadmap-shell{background:#fff;border-radius:34px;border:1px solid rgba(13,42,99,.08);box-shadow:var(--shadow-sm);padding:24px}
    .month-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
    .month{border-radius:25px;padding:28px;min-height:365px;border:1px solid var(--line);position:relative;overflow:hidden}
    .month:nth-child(2){background:var(--navy);color:#fff;border-color:var(--navy)}
    .month:nth-child(3){background:#FFF5F5;border-color:#F7D8DB}
    .month-top{display:flex;justify-content:space-between;gap:15px;align-items:start}
    .month-tag{font-size:11px;font-weight:950;letter-spacing:.13em;text-transform:uppercase;color:var(--red)}
    .month:nth-child(2) .month-tag{color:#FF9DA5}
    .month .big-number{font-size:70px;line-height:.8;font-weight:950;letter-spacing:-.08em;color:rgba(13,42,99,.08)}
    .month:nth-child(2) .big-number{color:rgba(255,255,255,.12)}
    .month h3{font-size:30px;letter-spacing:-.04em;line-height:1.06;color:var(--navy);margin:42px 0 12px}
    .month:nth-child(2) h3{color:#fff}
    .month p{font-size:14px;line-height:1.7;color:var(--muted);margin:0 0 22px}
    .month:nth-child(2) p{color:#C9D3E4}
    .month ul{list-style:none;margin:0;padding:0;display:grid;gap:10px;font-size:13px;font-weight:800;color:#42506A}
    .month:nth-child(2) ul{color:#E0E7F2}
    .month li{display:flex;align-items:center;gap:9px}
    .month li:before{content:"✓";width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;background:#E8F3EC;color:#1E7B42;font-size:10px;flex:0 0 auto}

    .experience{background:#fff}
    .experience-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:44px;align-items:stretch}
    .experience-copy{padding:28px 0;display:flex;flex-direction:column;justify-content:center}
    .experience-copy h2{margin-bottom:22px}
    .experience-copy>p{color:var(--muted);line-height:1.8;margin:0 0 27px;font-size:16px}
    .checks{display:grid;gap:14px;margin-bottom:30px}
    .check-row{display:flex;gap:12px;align-items:flex-start;color:#39465D;font-size:14px;font-weight:750}
    .check-row i{width:25px;height:25px;border-radius:50%;background:#EDF4FF;color:var(--navy);font-style:normal;display:flex;align-items:center;justify-content:center;flex:0 0 auto;font-size:11px}
    .experience-visual{position:relative;border-radius:34px;min-height:560px;background:linear-gradient(145deg,#102F6D,#071A3C);overflow:hidden;padding:34px;color:#fff}
    .experience-visual:before{content:"";position:absolute;inset:-100px -90px auto auto;width:330px;height:330px;border-radius:50%;background:rgba(214,31,44,.95)}
    .experience-visual:after{content:"";position:absolute;inset:auto auto -180px -100px;width:360px;height:360px;border-radius:50%;background:rgba(255,255,255,.06)}
    .visual-grid{position:relative;z-index:2;height:100%;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1.1fr .9fr;gap:14px}
    .visual-card{border-radius:24px;background:rgba(255,255,255,.095);border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(12px);padding:22px;display:flex;flex-direction:column;justify-content:space-between;min-height:190px}
    .visual-card:first-child{grid-column:span 2;min-height:250px;background:rgba(255,255,255,.11)}
    .visual-card small{font-size:10px;text-transform:uppercase;letter-spacing:.14em;font-weight:950;color:#BFCBE0}
    .visual-card strong{font-size:27px;line-height:1.03;letter-spacing:-.04em;max-width:310px}
    .visual-card:first-child strong{font-size:42px;max-width:520px}
    .visual-card p{font-size:12px;color:#D0D8E5;line-height:1.6;margin:8px 0 0}

    .outcomes{background:#F7F9FC}
    .outcome-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
    .outcome{background:#fff;border:1px solid var(--line);border-radius:24px;padding:26px;display:grid;grid-template-columns:52px 1fr;gap:18px;align-items:start}
    .outcome-icon{width:52px;height:52px;border-radius:17px;background:#F1F4FA;color:var(--navy);display:flex;align-items:center;justify-content:center;font-size:21px}
    .outcome:nth-child(4) .outcome-icon{background:#FFF0F1;color:var(--red)}
    .outcome h3{font-size:18px;color:var(--navy);margin:1px 0 7px}
    .outcome p{margin:0;color:var(--muted);line-height:1.6;font-size:13px}

    .cta-section{padding-top:78px;padding-bottom:110px;background:#fff}
    .cta-box{position:relative;overflow:hidden;border-radius:40px;background:var(--red);color:#fff;padding:56px;display:grid;grid-template-columns:1.2fr .8fr;gap:45px;align-items:center;box-shadow:0 28px 80px rgba(214,31,44,.2)}
    .cta-box:before{content:"8";position:absolute;right:-12px;top:-45px;font-size:320px;line-height:1;font-weight:1000;color:rgba(255,255,255,.08);letter-spacing:-.12em}
    .cta-box .kicker{color:#FFD2D5}
    .cta-box h2{color:#fff;max-width:680px}
    .cta-box p{color:#FFE7E9;line-height:1.7;max-width:670px;font-size:16px;margin:21px 0 0}
    .seat-card{position:relative;z-index:2;background:#fff;color:var(--ink);border-radius:28px;padding:26px;box-shadow:0 22px 50px rgba(111,10,19,.2)}
    .seat-card small{color:var(--muted);font-weight:850;text-transform:uppercase;letter-spacing:.1em}
    .seat-card .seat-big{font-size:78px;line-height:.95;font-weight:1000;color:var(--navy);letter-spacing:-.08em;margin:12px 0 2px}
    .seat-card h3{margin:0;color:var(--navy);font-size:21px}
    .seat-card p{color:var(--muted);font-size:13px;margin:10px 0 20px}
    .seat-card .btn{width:100%}

    .faq{background:var(--paper);padding-top:15px}
    .faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:55px;align-items:start}
    .faq-list{display:grid;gap:10px}
    details{background:#fff;border:1px solid var(--line);border-radius:18px;padding:0 20px}
    summary{cursor:pointer;list-style:none;padding:20px 4px;font-weight:900;color:var(--navy);display:flex;justify-content:space-between;gap:20px}
    summary::-webkit-details-marker{display:none}
    summary:after{content:"+";font-size:22px;color:var(--red)}
    details[open] summary:after{content:"−"}
    details p{margin:0 4px 20px;color:var(--muted);line-height:1.65;font-size:14px}

    footer{background:var(--navy-deep);color:#fff;padding:50px 20px 26px}
    .footer-grid{max-width:var(--max);margin:auto;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end}
    .footer-brand{display:flex;align-items:center;gap:14px}
    .footer-brand img{width:62px;height:62px;border-radius:18px;background:#fff;object-fit:contain}
    .footer-brand strong{display:block;font-size:20px}
    .footer-brand span{display:block;color:#AEBBD1;font-size:12px;margin-top:4px}
    .footer-links{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:18px;color:#B8C3D6;font-size:13px;font-weight:800}
    .copyright{max-width:var(--max);margin:35px auto 0;padding-top:22px;border-top:1px solid rgba(255,255,255,.1);display:flex;justify-content:space-between;gap:20px;color:#8191AD;font-size:11px}

    .reveal{opacity:0;transform:translateY(20px);transition:opacity .65s ease,transform .65s ease}
    .reveal.visible{opacity:1;transform:none}

    .mobile-nav{display:none}
